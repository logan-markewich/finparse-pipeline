# LlamaParse — required for parsing and extraction
LLAMA_CLOUD_API_KEY=llx-...

# LLM provider — used for cross-document analysis
# Any litellm-compatible model string works:
#   openai/gpt-4o, anthropic/claude-sonnet-4-6, etc.
LLM_MODEL=openai/gpt-4o
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Database (default: local SQLite file)
DATABASE_URL=sqlite+aiosqlite:///./finparse.db
